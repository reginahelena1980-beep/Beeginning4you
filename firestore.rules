rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Configurações globais do site, WhatsApp oficial, sala Google Meet e Disponibilidade de Horários
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Demandas, formulários de contato e diagnósticos enviados pelos clientes
    match /demands/{demandId} {
      allow read, write: if true;
    }

    // Agendamentos de reuniões Google Meet e notas integradas
    match /appointments/{appointmentId} {
      allow read, write: if true;
    }

    // Bloqueio padrão para todas as outras coleções não autorizadas
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
