# ==============================================================================
# BEEginning 4 You — Environment Variables Template
# ==============================================================================

# Firebase Admin SDK (Vercel Functions / Backend)
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Gmail SMTP (Automated booking confirmation emails)
GMAIL_USER=
GMAIL_APP_PASSWORD=
SMTP_PASSWORD=

# WhatsApp Gateway (Optional)
WHATSAPP_GATEWAY_URL=
WHATSAPP_GATEWAY_TOKEN=
ALLOWED_WHATSAPP_GATEWAY_DOMAINS=

# Proxy & Security Config
TRUST_PROXY=1
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_APPOINTMENTS_MAX=10

# Firebase Client SDK (Frontend / Vite)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# AI Studio / Gemini API (Optional)
GEMINI_API_KEY=