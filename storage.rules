rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.email == 'beeginning4you@gmail.com' &&
        request.auth.token.email_verified == true;
    }

    // Permite leitura pública de fotos de perfil; upload e exclusão apenas para o administrador oficial autorizado
    match /profile_photos/{photoId} {
      allow read: if true;
      allow write: if isAdmin()
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
